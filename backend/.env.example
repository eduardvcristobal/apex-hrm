# Copy to .env for local-only configuration. Never commit secrets.
DB_URL=jdbc:postgresql://localhost:5432/apex_hrm
DB_USER=hrm
DB_PASSWORD=hrm
SERVER_PORT=8080

# Google Identity Services client ID. Leave blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
PLATFORM_ADMIN_EMAILS=

# Generate with: openssl rand -base64 32. Keep the key stable for stored MFA/mail secrets.
HRM_MFA_ENCRYPTION_KEY=

# SMTP is used only for password recovery and invitation delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Set true only when SMTP is configured and should be included in /actuator/health.
SMTP_HEALTH_ENABLED=false
INVITATION_FROM=
INVITATION_ACCEPT_URL=http://localhost:5173/invite/accept
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Optional platform backup settings (requires age, pg_dump, pg_restore and psql).
APP_BACKUP_DB_URL=
APP_BACKUP_DB_USERNAME=
APP_BACKUP_DB_PASSWORD=

# Platform operations: generate an age key pair and keep the identity private.
APP_BACKUP_AGE_RECIPIENT=
APP_BACKUP_AGE_IDENTITY=
APP_BACKUP_DIRECTORY=
